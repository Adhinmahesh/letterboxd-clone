# Backend Server Configuration
PORT=5000

# MongoDB Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/letterboxd?retryWrites=true&w=majority

# JWT Secret for Session & Auth Tokens
JWT_SECRET=your_jwt_secret_key_here

# The Movie Database (TMDB) API Key
TMDB_API_KEY=your_tmdb_api_key_here

# SMTP / Email OTP Verification Settings
ADMIN_EMAIL=your_email@gmail.com
GMAIL_USERNAME=your_email@gmail.com
GMAIL_PASSWORD=your_gmail_app_password_here
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_DEFAULT_SENDER=your_email@gmail.com
